# Kopiere diese Datei nach .env.local (lokal) bzw. trage die Werte in Vercel ein.
# NIEMALS echte Werte committen.

# Öffentliche URL der App (lokal http://localhost:3000, später z. B. https://game-compass.vercel.app)
APP_URL=http://localhost:3000

# Zufälliger Schlüssel für Login-Sessions, mind. 32 Zeichen:  openssl rand -base64 48
SESSION_SECRET=

# https://steamcommunity.com/dev/apikey  (als Domain deine App-Domain eintragen)
STEAM_API_KEY=

# Supabase → Project Settings → API Keys: Project URL + "secret" Key (sb_secret_...)
# (Mit der Vercel-Supabase-Integration werden SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY automatisch gesetzt – reicht auch.)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# https://aistudio.google.com/apikey  (Free Tier, keine Kreditkarte nötig)
GEMINI_API_KEY=

# Deine SteamID64 (17 Ziffern) – wird automatisch Admin & freigeschaltet. Mehrere mit Komma.
ADMIN_STEAM_IDS=

# Optional
# GEMINI_MODEL=gemini-3.8-flash                 # Profil, Empfehlungen, Chat
# GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite   # Massen-Analyse der Spiele
# GEMINI_EMBED_MODEL=gemini-embedding-001
# AI_DAILY_LIMIT_PER_USER=150      # Profil, Empfehlungen, Chat
# AI_DAILY_ANALYSIS_LIMIT=600      # einmalige Spiel-Analysen (geteilt)
# STEAM_COUNTRY=DE

# Deals (optional): kostenloser Key unter https://isthereanydeal.com/apps/my  (App registrieren)
# ITAD_API_KEY=
# Empfehlungscode für "Bei Instant Gaming suchen"-Links (öffentlich, leer lassen = ohne Code)
# INSTANT_GAMING_REF=gamer-81a1cce

# E-Mail-Benachrichtigungen (optional) – z. B. Gmail: myaccount.google.com/apppasswords (2FA nötig)
# SMTP_USER=deine.adresse@gmail.com
# SMTP_PASS=                       # 16-stelliges App-Passwort, NICHT dein Gmail-Passwort
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM="GameCompass <deine.adresse@gmail.com>"
# Täglicher Check (Vercel Cron): zufälliger Wert, z. B. openssl rand -hex 32
# CRON_SECRET=
